{
  "name": "feel-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Feel UI（栖羽）- 基于 Shadcn UI 规范的跨框架组件库，Vue 3 与 React 19 双框架",
  "type": "module",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build:tokens": "pnpm --filter @feel-ui/tokens build",
    "build:styles": "pnpm --filter @feel-ui/styles build",
    "build:cva": "pnpm --filter @feel-ui/cva build",
    "build:hooks": "pnpm --filter @feel-ui/hooks build",
    "build:utils": "pnpm --filter @feel-ui/utils build",
    "build:vue": "pnpm --filter @feel-ui/vue build",
    "build:react": "pnpm --filter @feel-ui/react build",
    "build:all": "pnpm -r --filter './packages/**' run build",
    "dev:docs": "pnpm --filter @feel-ui/docs dev",
    "build:docs": "pnpm --filter @feel-ui/docs build",
    "dev:demo": "pnpm --filter @feel-ui/demo dev",
    "build:demo": "pnpm --filter @feel-ui/demo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@feel-ui/eslint": "workspace:*",
    "@feel-ui/tsconfig": "workspace:*",
    "@feel-ui/vite": "workspace:*",
    "@feel-ui/vitest": "workspace:*",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-vue": "^5.1.3",
    "eslint": "^9.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "vue": "^3.5.5"
  }
}